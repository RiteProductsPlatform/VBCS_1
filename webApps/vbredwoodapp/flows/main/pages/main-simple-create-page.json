{
  "title": "",
  "description": "",
  "variables": {
    "avatar": {
      "type": {
        "initials": "string",
        "src": "string"
      },
      "defaultValue": {
        "initials": "",
        "src": ""
      }
    },
    "contextualInfoLabelVisible": {
      "type": "boolean",
      "defaultValue": false
    },
    "contextualInfoSticky": {
      "type": "boolean",
      "defaultValue": false
    },
    "dirtyDataFlag": {
      "type": "boolean",
      "defaultValue": false
    },
    "dirtyDialogOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "displayMode": {
      "type": "string"
    },
    "formState": {
      "type": "string",
      "defaultValue": ""
    },
    "goToParentOption": {
      "type": "boolean",
      "defaultValue": false
    },
    "isSaved": {
      "type": "boolean",
      "defaultValue": false
    },
    "objectId": {
      "type": "string",
      "defaultValue": ""
    },
    "primaryAlwaysOn": {
      "type": "boolean",
      "defaultValue": true
    },
    "saveOption": {
      "type": "string",
      "defaultValue": "off"
    },
    "employeeVar": {
      "type": "employeeType",
      "defaultValue": {
        "empid": "",
        "empname": "",
        "empemail": "",
        "empsupervisor": "",
        "empdesignation": "",
        "empstatus": "",
        "emptotexp": "",
        "empgrade": ""
      }
    },
    "designationArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "Developer", "label": "Developer" },
        { "value": "Manager", "label": "Manager" },
        { "value": "Analyst", "label": "Analyst" },
        { "value": "Consultant", "label": "Consultant" }
      ]
    },
    "designationDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.designationArray }}"
      }
    },
    "statusArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "Active", "label": "Active" },
        { "value": "Inactive", "label": "Inactive" },
        { "value": "On Leave", "label": "On Leave" }
      ]
    },
    "statusDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.statusArray }}"
      }
    },
    "employeeArray": {
      "type": "employeeType[]",
      "defaultValue": []
    },
    "employeeADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "employeeType",
        "keyAttributes": "empid",
        "data": "{{ $page.variables.employeeArray }}"
      }
    }
  },
  "metadata": {},
  "types": {
    "employeeType": {
      "empid": "string",
      "empname": "string",
      "empemail": "string",
      "empsupervisor": "string",
      "empdesignation": "string",
      "empstatus": "string",
      "emptotexp": "string",
      "empgrade": "string"
    }
  },
  "eventListeners": {
    "confirmNoOjAction": {
      "chains": [
        {
          "chain": "dialogResponseChain",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "response": "NO"
          }
        }
      ]
    },
    "confirmYesOjAction": {
      "chains": [
        {
          "chain": "dialogResponseChain",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "response": "YES"
          }
        }
      ]
    },
    "ojdynamicFormTransientValueChangeChain": {
      "chains": [
        {
          "chain": "dynamicFormTransientValueChangeChain",
          "parameters": {
            "detail": "{{ $event.detail}}"
          }
        }
      ]
    },
    "ojSpCancel": {
      "chains": [
        {
          "chain": "spCancelChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "ojSpGoToParent": {
      "chains": [
        {
          "chain": "goToParent",
          "parameters": {}
        }
      ]
    },
    "ojSpSave": {
      "chains": [
        {
          "chain": "spSaveChain"
        }
      ]
    },
    "ojSpSubmit": {
      "chains": [
        {
          "chain": "spSubmitChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "vbBeforeExit": {
      "chains": [
        {
          "chain": "checkBeforeExit",
          "parameters": {}
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "chain": "fetchEmployeeDataChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-dynamic-form": {
        "path": "oj-dynamic/form/loader"
      },
      "oj-form-layout": {
        "path": "ojs/ojformlayout"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-label": {
        "path": "ojs/ojlabel"
      },
      "oj-sp-message-unsaved-changes": {
        "path": "oj-sp/message-unsaved-changes/loader"
      },
      "oj-sp-simple-create-edit": {
        "path": "oj-sp/simple-create-edit/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      }
    }
  },
  "@dt": {
    "iconClass": "vbdt-dynamic-icon-16-icoSimpleCreateAndEdit48Svg"
  }
}
